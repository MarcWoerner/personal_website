<!-- Sticky header. The box-shadow + clip-path trick stretches the white background
     and the bottom line to the full window width while the header stays inside the prose column. -->
<header class="sticky top-0 z-50 bg-white shadow-[0_0_0_100vmax_white] [clip-path:inset(0_-100vmax)] pt-4 pb-2 mb-4">
	<nav>
	  <div class="flex flex-wrap font-mono font-medium gap-x-4 gap-y-2 px-4 sm:px-0 my-2">
		<a href="/" class="mr-1 hover:underline">Home</a>
		<a href="/projects/" class="mr-1 hover:underline">Projects</a>
		<a href="/articles/" class="mr-1 hover:underline">Articles</a>
		<a href="/books/" class="mr-1 hover:underline">Books</a>
	  </div>
	</nav>
	<div class="absolute bottom-0 left-0 right-0 h-0.5 bg-black shadow-[0_0_0_100vmax_black] [clip-path:inset(0_-100vmax)]"></div>
</header>
